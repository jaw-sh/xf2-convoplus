  <div class="block"><div class="block-container"><h3 class="block-header">{{ phrase('hb_convo_pruned_report_history') }}</h3>
    <ul class="block-body"><xf:foreach loop="$history" value="$event">
      <li class="block-row">#{$event.report_comment_id}: {{ date_time($event.comment_date) }} <xf:if is="$event.is_report">{{ phrase('report_noun') }}</xf:if> {$event.state_change}</li>
