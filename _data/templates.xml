        <xf:cell>{$row.hold_reason}</xf:cell>
        <xf:cell>{{ date_time($row.purge_after) }}</xf:cell>
        <xf:action href="{{ link('hb-convo-prune/restore', null, {'conversation_id': $row.conversation_id}) }}">{{ phrase('hb_convo_prune_restore') }}</xf:action>
      </xf:datarow>
    </xf:foreach>
  </xf:datalist></div></div>
<xf:else />
  <div class="blockMessage">{{ phrase('hb_convo_prune_no_pending') }}</div>
</xf:if>]]></template>
