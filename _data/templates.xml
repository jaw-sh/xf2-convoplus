  <template type="public" title="hb_convo_report_macros" version_id="9" version_string="2.4.2"><![CDATA[<xf:macro id="join_conversation" arg-report="!">
	<xf:if is="$report.Content && $report.Content.Conversation">
		<xf:if is="in_array($xf.visitor.user_id, $report.Content.Conversation.active_recipient_user_ids)">
			<div class="block-footer">
				<span class="block-footer-controls"><xf:button href="{{ link('direct-messages/replies', $report.Content) }}">{{ phrase('go_to_content') }}</xf:button></span>
			</div>
		<xf:elseif is="in_array($report.report_state, ['open', 'assigned'])" />
			<div class="block-footer">
				<span class="block-footer-controls"><xf:button href="{{ link('reports/go-to-content', $report) }}" overlay="true">{{ phrase('hb_convo_force_join') }}</xf:button></span>
			</div>
		</xf:if>
	</xf:if>
</xf:macro>]]></template>
  <template type="admin" title="hb_convo_prune_settings" version_id="10" version_string="2.5.0"><![CDATA[<xf:title>{{ phrase('hb_convo_prune_title') }}</xf:title>
<xf:pageaction>
  <xf:button href="{{ link('hb-convo-prune/queue') }}">{{ phrase('hb_convo_prune_queue') }}</xf:button>
  <xf:button href="{{ link('hb-convo-prune/restore') }}">{{ phrase('hb_convo_prune_restore') }}</xf:button>
  <xf:button href="{{ link('hb-convo-prune/preview') }}">{{ phrase('hb_convo_prune_preview') }}</xf:button>
  <xf:button href="{{ link('hb-convo-prune/log') }}">{{ phrase('hb_convo_prune_log') }}</xf:button>
</xf:pageaction>
<xf:if is="$disabled"><div class="blockMessage blockMessage--warning">{{ phrase('hb_convo_prune_disabled') }}</div></xf:if>
<xf:if is="$config.tripped_date">
  <div class="blockMessage blockMessage--error">{{ phrase('hb_convo_prune_breaker_tripped') }} {{ date_time($config.tripped_date) }}</div>
  <xf:form action="{{ link('hb-convo-prune/reset-breaker') }}" class="block">
    <xf:button type="submit">{{ phrase('hb_convo_prune_reset_breaker') }}</xf:button>
  </xf:form>
</xf:if>
<xf:form action="{{ link('hb-convo-prune/save') }}" ajax="true" class="block">
  <div class="block-container"><div class="block-body">
    <xf:selectrow name="mode" value="{$config.mode}" label="{{ phrase('hb_convo_prune_mode') }}">
      <xf:option value="off">{{ phrase('hb_convo_prune_off') }}</xf:option>
      <xf:option value="dry_run">{{ phrase('hb_convo_prune_dry_run') }}</xf:option>
      <xf:option value="live">{{ phrase('hb_convo_prune_live') }}</xf:option>
    </xf:selectrow>
    <xf:numberboxrow name="inactivity_days" value="{$config.inactivity_days}" min="1" label="{{ phrase('hb_convo_prune_inactivity_days') }}" />
    <xf:numberboxrow name="grace_days" value="{$config.grace_days}" min="1" label="{{ phrase('hb_convo_prune_grace_days') }}" />
    <xf:numberboxrow name="max_per_run" value="{$config.max_per_run}" min="1" label="{{ phrase('hb_convo_prune_max_per_run') }}" />
    <xf:numberboxrow name="max_per_day" value="{$config.max_per_day}" min="1" label="{{ phrase('hb_convo_prune_max_per_day') }}" />
  </div><xf:submitrow icon="save" /></div>
</xf:form>]]></template>
  <template type="admin" title="hb_convo_prune_restore" version_id="10" version_string="2.5.0"><![CDATA[<xf:title>{{ phrase('hb_convo_prune_restore') }}</xf:title>
<xf:breadcrumb href="{{ link('hb-convo-prune') }}">{{ phrase('hb_convo_prune_title') }}</xf:breadcrumb>
<div class="blockMessage">{{ phrase('hb_convo_prune_metadata_only') }}</div>
<xf:form action="{{ link('hb-convo-prune/restore') }}" method="get" class="block">
  <div class="block-container"><div class="block-body">
    <xf:numberboxrow name="conversation_id" value="{$conversationId}" min="1" label="{{ phrase('hb_convo_prune_id') }}" />
  </div><xf:submitrow submit="{{ phrase('search') }}" /></div>
</xf:form>
<xf:if is="$metadata">
  <div class="block"><div class="block-container"><div class="block-body">
    <xf:formrow label="{{ phrase('hb_convo_prune_id') }}">{$metadata.conversation_id}</xf:formrow>
    <xf:formrow label="{{ phrase('hb_convo_prune_start_date') }}"><xf:if is="$metadata.start_date">{{ date_time($metadata.start_date) }}</xf:if></xf:formrow>
    <xf:formrow label="{{ phrase('hb_convo_prune_last_date') }}"><xf:if is="$metadata.last_message_date">{{ date_time($metadata.last_message_date) }}</xf:if></xf:formrow>
    <xf:formrow label="{{ phrase('hb_convo_prune_participant_count') }}">{$metadata.recipient_count}</xf:formrow>
    <xf:formrow label="{{ phrase('hb_convo_prune_state') }}">{$metadata.state}</xf:formrow>
    <xf:formrow label="{{ phrase('hb_convo_prune_hold_reason') }}">{$metadata.hold_reason}</xf:formrow>
    <xf:formrow label="{{ phrase('hb_convo_prune_pruned_date') }}">{{ date_time($metadata.pruned_date) }}</xf:formrow>
    <xf:formrow label="{{ phrase('hb_convo_prune_purge_after') }}">{{ date_time($metadata.purge_after) }}</xf:formrow>
  </div></div></div>
  <xf:if is="($metadata.state == 'pending' || $metadata.state == 'held') AND $metadata.start_date">
    <xf:if is="$metadata.state == 'held'">
      <xf:form action="{{ link('hb-convo-prune/release-hold') }}" class="block">
        <xf:hiddenval name="conversation_id">{$metadata.conversation_id}</xf:hiddenval>
        <xf:button type="submit">{{ phrase('hb_convo_prune_release_hold') }}</xf:button>
      </xf:form>
    </xf:if>
    <xf:form action="{{ link('hb-convo-prune/restore') }}" class="block">
      <xf:hiddenval name="conversation_id">{$metadata.conversation_id}</xf:hiddenval>
      <xf:button type="submit">{{ phrase('restore') }}</xf:button>
    </xf:form>
  </xf:if>
<xf:elseif is="$conversationId" />
  <div class="blockMessage">{{ phrase('hb_convo_prune_not_found') }}</div>
</xf:if>]]></template>
  <template type="admin" title="hb_convo_prune_queue" version_id="10" version_string="2.5.0"><![CDATA[<xf:title>{{ phrase('hb_convo_prune_queue') }}</xf:title>
<xf:breadcrumb href="{{ link('hb-convo-prune') }}">{{ phrase('hb_convo_prune_title') }}</xf:breadcrumb>
<div class="blockMessage">{{ phrase('hb_convo_prune_metadata_only') }}</div>
