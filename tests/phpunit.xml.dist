<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="https://schema.phpunit.de/10.5/phpunit.xsd"
         bootstrap="bootstrap.php" cacheResult="false" colors="true"
         failOnRisky="true" failOnWarning="true"
         displayDetailsOnSkippedTests="true">
    <testsuites>
        <testsuite name="unit"><directory>Unit</directory></testsuite>
        <testsuite name="schema"><file>Integration/SchemaCoverageTest.php</file></testsuite>
        <testsuite name="integration"><directory>Integration</directory><exclude>Integration/SchemaCoverageTest.php</exclude></testsuite>
    </testsuites>
    <php><ini name="error_reporting" value="-1"/></php>
</phpunit>
